# Development Environment Configuration
# Database Configuration
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5433/learninslices_dev
REDIS_URL=redis://localhost:6380

# Security Configuration (Development Only - Change for Production)
SECRET_KEY=dev-secret-key-not-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-for-development

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=LearnInSlices API (Dev)
VERSION=1.0.0-dev

# Development Settings
DEBUG=True
LOG_LEVEL=DEBUG
ENVIRONMENT=development

# AI Configuration
AI_CONTENT_GENERATION_ENABLED=true
AI_RECOMMENDATIONS_ENABLED=true
AI_ANALYTICS_ENABLED=true
AI_DIFFICULTY_ASSESSMENT_ENABLED=true

# Development Performance Settings
WORKERS=1
MAX_CONNECTIONS=50
KEEP_ALIVE=30

# Development File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_PATH=./uploads

# Cache Configuration
CACHE_TTL=1800  # 30 minutes
REDIS_MAX_CONNECTIONS=10

# Hot Reload Settings
RELOAD=True
RELOAD_DIRS=["./app", "./"]

# Model Settings for Development
HF_CACHE_DIR=./models/cache
MODEL_DOWNLOAD_TIMEOUT=300
