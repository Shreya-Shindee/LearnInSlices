# AI Configuration for LearnInSlices
# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7

# Local AI Models Configuration
HF_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_CACHE_DIR=./models/cache
MAX_SEQUENCE_LENGTH=512

# AI Service Configuration
AI_CONTENT_GENERATION_ENABLED=true
AI_RECOMMENDATIONS_ENABLED=true
AI_ANALYTICS_ENABLED=true
AI_DIFFICULTY_ASSESSMENT_ENABLED=true

# Model Performance Settings
EMBEDDING_BATCH_SIZE=32
GENERATION_TIMEOUT_SECONDS=30
RECOMMENDATION_CACHE_TTL=3600
ANALYTICS_BATCH_SIZE=100

# Content Generation Settings
DEFAULT_CONTENT_LENGTH=200
MAX_CONTENT_LENGTH=1000
SUPPORTED_LANGUAGES=["en", "es", "fr", "de"]
DIFFICULTY_LEVELS=["beginner", "intermediate", "advanced", "expert"]

# Recommendation Engine Settings
RECOMMENDATION_COUNT=10
SIMILARITY_THRESHOLD=0.7
COLLABORATIVE_WEIGHT=0.6
CONTENT_BASED_WEIGHT=0.4
USER_BEHAVIOR_WEIGHT=0.3

# Analytics Configuration
ANALYTICS_UPDATE_INTERVAL=300  # 5 minutes
PERFORMANCE_METRICS_RETENTION_DAYS=90
LEARNING_PATTERN_ANALYSIS_ENABLED=true
PREDICTIVE_ANALYTICS_ENABLED=true
